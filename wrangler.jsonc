{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "popcomputer-web-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // The client bundle `bun run build` writes; the Worker answers everything else.
  "assets": { "directory": "dist" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "popcomputer-web-demo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Counts each client address's sign-in, sign-up and password calls, and
  // each account's sign-ins, at Cloudflare's edge (auth.signInLimits).
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Identifies the deploy, so the page cache starts each deploy empty.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Clears the counts of failed sign-ins whose window has passed.
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ENVIRONMENT": "production" }
}
