{
  "name": "popcomputer-web-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A starting point for @popcomputer/web on Cloudflare Workers: React pages, D1 and Better Auth.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "bun run build",
    "build": "NODE_OPTIONS=\"--disable-warning=DEP0040 $NODE_OPTIONS\" vite build",
    "dev": "bun scripts/run-dev.ts",
    "stop": "bun scripts/stop-dev.ts",
    "check": "tsc --noEmit && echo 'Types: no errors' && oxlint && echo 'Lint: no problems' && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:seed": "bun scripts/database.ts seed",
    "db:reset": "bun scripts/database.ts reset",
    "db:execute": "bun scripts/database.ts execute",
    "cloudflare:login": "wrangler login",
    "env:check": "bun scripts/env-check.ts",
    "secret": "bun scripts/secret.ts",
    "deploy": "bun scripts/deploy.ts",
    "preview": "bun scripts/preview.ts",
    "status": "bun scripts/status.ts",
    "logs": "wrangler tail -c wrangler.jsonc",
    "rollback": "wrangler rollback -c wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@inertiajs/react": "3.9.1",
    "@popcomputer/web": "^1.4.1",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "hono": "4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "4.20260730.0",
    "oxlint": "1.82.0",
    "portless": "0.15.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  }
}
