{
  "name": "popcomputer-web-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A starting point for @popcomputer/web on Cloudflare Workers: React pages, D1 and Better Auth.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "bun run build",
    "build": "vite build",
    "dev": "concurrently --kill-others --names vite,worker \"vite\" \"wrangler dev --var ENVIRONMENT:development\"",
    "check": "tsc --noEmit && oxlint && bun test",
    "db:generate": "drizzle-kit generate",
    "db:create": "wrangler d1 create popcomputer-web-demo-db --binding DB --update-config",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "secret:generate": "openssl rand -base64 32 | wrangler secret put BETTER_AUTH_SECRET",
    "setup": "bun run db:create && bun run secret:generate",
    "deploy": "bun run build && bun run db:migrate && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@inertiajs/react": "3.9.1",
    "@popcomputer/web": "^1.0.0",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.3",
    "hono": "4.13.13",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "miniflare": "4.20260730.0",
    "oxlint": "1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "wrangler": "^4.149.0"
  }
}
