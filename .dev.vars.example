# The secrets the app needs. `bun run dev` writes .dev.vars with a new one the
# first time it runs, so there's nothing to copy; it replaces this placeholder
# if .dev.vars holds it. The Deploy to Cloudflare button asks for each value
# here: give it a new one, from `openssl rand -base64 32`, never this placeholder.
BETTER_AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32
